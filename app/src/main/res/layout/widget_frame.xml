<?xml version="1.0" encoding="utf-8"?>
<!-- Outer frame every widget shares: rounded surface, uniform padding, and a small
     app badge in the top-end corner (tapping it opens the app). The widget's own
     content is added into widget_content at render time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <ImageView
        android:id="@+id/widget_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="NerLan" />
</FrameLayout>
