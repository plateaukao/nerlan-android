<?xml version="1.0" encoding="utf-8"?>
<!-- Taller 學習紀錄: the number scales with the cell (set in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日學習"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/stats_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/widget_on_surface"
        android:textSize="42sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分鐘"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/stats_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/stats_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
